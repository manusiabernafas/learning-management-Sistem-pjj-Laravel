# Untuk XAMPP/Laragon tanpa virtual host: buka langsung http://localhost/lms-pjj
# (Jika memakai virtual host / hosting, arahkan document root ke folder public/ dan file ini tidak terpakai.)
<IfModule mod_rewrite.c>
    RewriteEngine On

    # Sudah diarahkan ke public/: berhenti
    RewriteRule ^public/ - [L]

    # File statis (css, js, foto menu) diambil dari folder public/
    RewriteRule ^((css|js|storage|build)/.*|favicon\.ico|robots\.txt)$ public/$1 [L]

    # Folder internal tidak boleh diakses dari browser
    RewriteRule ^(app|bootstrap|config|database|resources|routes|storage|tests|vendor)(/|$) - [F,L]

    # Semua halaman lain diproses Laravel
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

<FilesMatch "^(\.env.*|composer\.(json|lock)|artisan|package\.json|phpunit\.xml|vite\.config\.js|setup\.(bat|sh))$">
    Require all denied
</FilesMatch>
